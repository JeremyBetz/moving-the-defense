    "A": {"some_B5_to_B7_median_reduction_vs_B4_min": 0.05, "matches_improved_min": 6, "matches_worsened_10pct_or_more_max": 1, "adjacent_transition_material_required": false},
    "C": {"no_B5_to_B7_median_reduction_vs_B4_at_least": 0.02, "and_no_B5_to_B7_matches_improved_at_least": 4},
    "B": "all_valid_results_neither_A_nor_C",
