    "attacking_goalkeeper_excluded_by": "provider_role_metadata_and_on_pitch_bookkeeping",
    "ranking": "ascending_euclidean_distance_to_focal_at_c_in_standardized_105x68m_coordinates",
    "tie_break": "stable_provider_player_id_ascending_lexical_audit_only_not_predictor",
    "primary_K": 3,
    "sensitivity_K": 1,
    "sensitivity_sample": "exact_primary_K3_B7_complete_observations_no_sample_expansion",
    "rank_names": ["A1", "A2", "A3"],
    "history_membership": "identities_fixed_at_c_for_entire_pre_cutoff_history",
    "dynamic_reranking": false,
    "future_information": false,
    "tactical_assignment_interpretation": false
  },
  "coordinates": {
    "frame": "phase5a_defending_oriented_105x68m",
    "x": "metres_increasing_from_defending_own_goal_to_opponent_goal",
    "y": "metres_retaining_standardized_pitch_width_side_0_to_68",
    "cutoff_geometry": "transformed_raw_positions_at_c",
    "history_positions": "causal_trailing_7_frame_complete_mean",
    "terminal_velocity": "backward_difference_of_last_two_causal_smoothed_positions_divided_by_0_04_seconds"
  },
  "history_support": {
    "primary_seconds": 2.0,
    "raw_frames": 50,
    "raw_offsets_from_cutoff_seconds": {"start": -1.96, "stop": 0.0, "step": 0.04, "count": 50},
    "causal_trailing_smoothing_frames": 7,
    "complete_smoothed_positions": 44,
    "path_increments": 43,
    "first_valid_smoothed_offset_seconds": -1.72,
    "last_valid_smoothed_offset_seconds": 0.0,
    "terminal_velocity_support_offsets_seconds": [-0.04, 0.0],
    "raw_data_after_cutoff_used": false,
    "one_second_sensitivity": {"raw_frames": 25, "raw_offsets_start": -0.96, "raw_offsets_stop": 0.0, "complete_smoothed_positions": 19, "path_increments": 18, "first_valid_smoothed_offset": -0.72, "K1_uses_corresponding_K3_observations": true}
  },
  "feature_ladder": {
    "cumulative": true,
    "B4": "exact_phase5a_B4",
    "B5_add": {
      "question": "where_nearby_attackers_are_at_c",
      "rank_specific_for_each_Ai": ["focal_minus_Ai_x_m", "focal_minus_Ai_y_m", "focal_Ai_distance_m", "Ai_ball_distance_m"],
      "configuration": ["selected_attackers_x_span_m", "selected_attackers_y_span_m"],
      "primary_K3_addition_count": 14,
      "sensitivity_K1_addition_count": 4,
      "K1_selected_set_spans": "omitted_singleton_no_meaningful_span",
      "omitted_exact_or_linear_aliases": ["attacker_absolute_x_y_given_B4_focal_position_and_signed_displacement", "minimum_mean_range_focal_distance_given_rank_specific_distances"],
      "density_diagnostic": "A3_distance_continuous_no_threshold_counts"
    },
    "B6_add": {
      "question": "how_fixed_nearby_attackers_moved_before_c",
      "rank_specific_for_each_Ai": ["Ai_recent_absolute_path_m", "Ai_terminal_vx_mps", "Ai_terminal_vy_mps"],
      "primary_K3_addition_count": 9,
      "sensitivity_K1_addition_count": 3,
      "acceleration": false,
      "omitted_exact_linear_aliases": ["mean_selected_attacker_path", "mean_selected_attacker_terminal_vx_vy"]
    },
    "B7_add": {
      "question": "nonlinear_pre_cutoff_pair_dynamics_beyond_independent_movement",
      "rank_specific_for_each_Ai": ["focal_Ai_distance_change_m", "focal_Ai_relative_path_m", "focal_approach_toward_Ai_mps", "Ai_approach_toward_focal_mps"],
      "primary_K3_addition_count": 12,
      "sensitivity_K1_addition_count": 4,
      "relative_vector": "r_Ai(t)=smoothed_x_Ai(t)-smoothed_x_focal(t)",
      "distance_change": "norm(r_Ai(c))-norm(r_Ai(first_valid_smoothed_history_time)); negative=closer positive=farther",
      "relative_path": "sum_over_consecutive_valid_smoothed_times norm(r_Ai(t_i)-r_Ai(t_i_minus_1))",
      "focal_to_attacker_unit_vector": "u_FAi=(smoothed_x_Ai(c)-smoothed_x_focal(c))/norm(smoothed_x_Ai(c)-smoothed_x_focal(c))",
      "focal_approach": "focal_terminal_velocity_dot_u_FAi; positive=toward_attacker",
      "attacker_approach": "attacker_terminal_velocity_dot_negative_u_FAi; positive=toward_focal",
      "terminal_projection_distance_tolerance_m": 1e-09,
      "zero_or_near_zero_terminal_distance": "if_smoothed_terminal_focal_attacker_distance_m_less_than_or_equal_to_1e-9_mark_both_projection_features_for_that_attacker_incomplete_and_entire_observation_B7_incomplete_no_division_epsilon_imputation_or_direction",
      "omitted_exact_aliases": ["terminal_pairwise_closure_rate_equals_sum_of_approach_components", "relative_terminal_vx_vy_equals_focal_velocity_minus_attacker_velocity"],
      "bearing_change": "excluded_primary_wraparound_and_near_coincidence_instability"
    }
  },
